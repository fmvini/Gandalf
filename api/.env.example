APP_NAME=Gandalf
APP_VERSION=0.1.0
BOOK_PROVIDER=local
ONLINE_CATALOG=false
# Use somente uma conta Groq Free, sem ativar faturamento. Nunca use VITE_ para chaves.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_LIMIT=50
AI_TIMEOUT_SECONDS=25
EXTERNAL_CACHE_TTL_SECONDS=3600
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
OPEN_LIBRARY_BASE_URL=https://openlibrary.org
OPEN_LIBRARY_CONTACT_EMAIL=
BOOK_SEARCH_CACHE_TTL_SECONDS=300
POSTGRES_PASSWORD=change_me_local
DATABASE_URL=postgresql+psycopg://gandalf:change_me_local@127.0.0.1:5433/gandalf
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10
