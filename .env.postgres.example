# Copy to .env.postgres; never commit real values.
# This file is for Compose interpolation, not api/.env.
POSTGRES_DB=gandalf
POSTGRES_USER=gandalf
POSTGRES_PASSWORD=replace_with_a_strong_password
# Percent-encode reserved characters in the password within this URL.
# Inside Compose, the host is db and the port is 5432.
GANDALF_DEPLOY_DATABASE_URL=postgresql+psycopg://gandalf:replace_with_a_strong_password@db:5432/gandalf
JWT_SECRET=replace_with_a_random_stable_secret_at_least_32_characters
# The frontend proxy uses the same origin. JSON array for separate origins.
CORS_ORIGINS=[]
ONLINE_CATALOG=false
BOOK_PROVIDER=local
